# ==============================================
# ABUJA REALTY AI - ENVIRONMENT CONFIGURATION
# ==============================================

# Node Environment
NODE_ENV=development

# ==============================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==============================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=user
DB_PASSWORD=password
DB_NAME=abuja_realty

# Full database URL (alternative to separate values)
DATABASE_URL=postgresql://user:password@localhost:5432/abuja_realty

# ==============================================
# REDIS CONFIGURATION
# ==============================================
REDIS_URL=redis://localhost:6379

# ==============================================
# BACKEND SERVER CONFIGURATION
# ==============================================
BACKEND_PORT=3000
CORS_ORIGIN=*

# ==============================================
# WHATSAPP BUSINESS API
# ==============================================
# Get these from Meta for Developers (https://developers.facebook.com)
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token_here

# ==============================================
# GOOGLE APIS
# ==============================================
# Get from Google Cloud Console (https://console.cloud.google.com)

# Google Maps Platform API Key
# Enable: Maps JavaScript API, Places API, Geocoding API, Directions API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Gemini API Key (for AI agents)
# Get from Google AI Studio (https://makersuite.google.com/app/apikey)
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key_here

# Google Cloud Project ID
GOOGLE_CLOUD_PROJECT_ID=your_project_id_here

# ==============================================
# ADK AGENT SERVER CONFIGURATION
# ==============================================
AGENTS_PORT=8000
ADK_AGENT_URL=http://localhost:8000

# ==============================================
# FRONTEND CONFIGURATION
# ==============================================
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3000

# ==============================================
# LOGGING
# ==============================================
LOG_LEVEL=info

# ==============================================
# SETUP INSTRUCTIONS
# ==============================================
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Get WhatsApp Business API credentials:
#    - Go to https://developers.facebook.com
#    - Create a Business App
#    - Add WhatsApp product
#    - Get Phone Number ID and Access Token
#    - Set a custom Verify Token
#
# 3. Get Google Maps API Key:
#    - Go to https://console.cloud.google.com
#    - Enable Maps, Places, Geocoding, Directions APIs
#    - Create API key with appropriate restrictions
#
# 4. Get Google Gemini API Key:
#    - Go to https://makersuite.google.com/app/apikey
#    - Create API key for Gemini
#
# 5. Update all placeholder values with your actual credentials
#
# 6. NEVER commit the .env file to version control!
#    It's already in .gitignore
#
# ==============================================
