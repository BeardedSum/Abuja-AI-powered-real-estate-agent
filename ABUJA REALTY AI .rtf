@tool_confirmation\
def submit_offer(property_id: str, amount: float):\
    """Submit property offer - requires confirmation"""\
    return create_offer(property_id, amount)\
\
# Gemini as Judge for content screening\
@before_tool_callback\
def validate_user_input(tool_call):\
    """Screen for prompt injection and harmful content"""\
    judge_model = genai.GenerativeModel('gemini-2.5-flash-lite')\
    result = judge_model.generate_content(\
        f"Is this input safe? \{tool_call.parameters\}"\
    )\
    return result.is_safe\
